{
  // AINumbers MCP Apps — Cloudflare Workers config.
  // First deploy: `npx wrangler deploy` → test at the printed workers.dev URL.
  // Cutover: uncomment "routes" below, delete the existing mcp CNAME → Render in the
  // Cloudflare DNS dashboard, then `npx wrangler deploy` again (creates the custom-domain record).
  "name": "ainumbers-mcp",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./data",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "mcp.ainumbers.co", "custom_domain": true }],
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "mcp_tool_calls" }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  // GAP-d event substrate (2026-07-10): weekly cron feeds GAP-a/EXPORT-1/suggestion-digest.
  // Queue is producer+consumer on THIS worker, Free-plan sizing (10k ops/day cap; design
  // target <100/day — three orders of magnitude under cap, see worker.mjs scheduled()).
  "triggers": {
    "crons": ["0 6 * * 1"]
  },
  "queues": {
    "producers": [
      { "queue": "ainumbers-events", "binding": "EVENTS_QUEUE" }
    ],
    "consumers": [
      { "queue": "ainumbers-events" }
    ]
  },
  // GAP-a (2026-07-10): CF Workflows durable orchestration. 1 step.do = 1 receipted kernel/check
  // run (see workflows/renewal-watch-workflow.mjs); durability sits UNDER the receipt layer, never
  // becomes the source of truth. Free-plan Workflows (GA, no paid-plan requirement): 3-day state
  // retention / 30s CPU per step — design checkpoints any >3-day wait to a signed artifact rather
  // than relying on Workflows-internal state (see GAP-A-DESIGN-DOC.md §A.3). Rides the live GAP-d
  // envelope (worker.mjs queue()); no new MCP tool, no /mcp behavior change.
  "workflows": [
    {
      "name": "renewal-watch",
      "binding": "RENEWAL_WATCH_WORKFLOW",
      "class_name": "RenewalWatchWorkflow"
    }
  ],
  // C1 (WORKER-HARDENING-GENERATOR-1, 2026-08-22): rate limiting for /mcp and /access/v1/* --
  // same binding type + config shape as anchor-suite's RELAY_LIMITER (anchor-suite/wrangler.jsonc),
  // proven live on this account. namespace_id must be unique per account; anchor-suite already
  // owns "2001", so this worker uses "3001"/"3002" (see worker.mjs's rateLimitExceeded()).
  //
  // MCP-REACH-DISPATCH-1 D3, PR 1 of 2 (2026-09-25): two NEW namespaces, provisioned here and
  // called in ADDITION to 3001/3002 -- no behaviour change, because 3005 (60/60 s per IP) is looser
  // than 3001 (30/60 s per IP) and is checked alongside it. PR 2 (held until this deploy proves 3005
  // answers live) is what MOVES 3001/3002 behind the size-capped parse and routes the static
  // discovery methods to 3006 instead.
  //   * 3005 MCP_PREPARSE_LIMITER        per-IP  60/60 s -- pre-parse on every POST; bounds parse CPU
  //                                                        per source, the job 3001 does today.
  //   * 3006 MCP_DISCOVERY_GLOBAL_LIMITER global 1200/60 s -- static discovery only (initialize,
  //                                                        tools/list, resources/list, prompts/list,
  //                                                        resources/templates/list, server/discover,
  //                                                        ping). WHY: tools/list is 13 pages, so ONE
  //                                                        client's full walk is ~16 requests and
  //                                                        ~18 walks/min exhausted the 300/60 s
  //                                                        GLOBAL bucket for every other caller --
  //                                                        discovery starving compute.
  // Namespace registry (checked 2026-09-25 on each repo's default branch): 2001 = anchor-suite
  // (anchor-suite/wrangler.jsonc:24); 3001/3002 = this worker; 3003/3004 RESERVED by
  // WEBMCP-FEEDBACK-LOOP-BUILD-SPEC-2026-09-23 row B; helm has no wrangler.* at all.
  "unsafe": {
    "bindings": [
      {
        "name": "MCP_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "3001",
        "simple": { "limit": 30, "period": 60 }
      },
      {
        "name": "MCP_GLOBAL_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "3002",
        "simple": { "limit": 300, "period": 60 }
      },
      {
        "name": "MCP_PREPARSE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "3005",
        "simple": { "limit": 60, "period": 60 }
      },
      {
        "name": "MCP_DISCOVERY_GLOBAL_LIMITER",
        "type": "ratelimit",
        "namespace_id": "3006",
        "simple": { "limit": 1200, "period": 60 }
      }
    ]
  }
}
